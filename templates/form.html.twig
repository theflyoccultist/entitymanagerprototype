<!DOCTYPE html>
<html>
<head>
  <title>Welcome</title>
</head>
<body>

  {% if mode == 'create' %}
    <h1>Create new entry</h1>
  {% else %}
    <h1>Edit entry</h1>
  {% endif %}

  {% if mode == 'create' %}
    <form action="/form" method="post">
  {% else %}
    <form action="/form/{{ id }}" method="post">
  {% endif %}
    <label for="name">Name:</label><br>
    <input type="text" id="name" name="name" value="{{ character.name }}"><br>
    
    {% set classes = ['Artificer', 'Barbarian', 'Bard', 'Cleric',
    'Druid', 'Fighter', 'Mage', 'Monk', 'Ranger', 'Rogue', 'Paladin', 
    'Psion', 'Sorcerer', 'Warlock'] %}

    <label for="class">Class:</label>
    <select id="class" name="class">
      {% for cl in classes %}
        {% if character.class == cl %}
          <option value="{{ cl }}" selected>{{ cl }}</option>
        {% else %}
          <option value="{{ cl }}">{{ cl }}</option>
        {% endif %}
      {% endfor %}
    </select><br>
    
    <label for="strength">Strength:</label><br>
    <select id="strength" name="strength">
      {% for i in 1..20 %}
        {% if character.stats.strength == i %}
          <option value="{{ i }}" selected>{{ i }}</option>
        {% else %}
          <option value="{{ i }}">{{ i }}</option>
        {% endif %}
      {% endfor %}
    </select><br>
    
    <label for="intelligence">Intelligence:</label><br>
    <select id="intelligence" name="intelligence">
      {% for i in 1..20 %}
        {% if character.stats.intelligence == i %}
          <option value="{{ i }}" selected>{{ i }}</option>
        {% else %}
          <option value="{{ i }}">{{ i }}</option>
        {% endif %}
      {% endfor %}
    </select><br>
    
    <label for="agility">Agility:</label><br>
    <select id="agility" name="agility">
      {% for i in 1..20 %}
        {% if character.stats.agility == i %}
          <option value="{{ i }}" selected>{{ i }}</option>
        {% else %}
          <option value="{{ i }}">{{ i }}</option>
        {% endif %}
      {% endfor %}
    </select><br>
    
    <fieldset>
    <legend>Equipment</legend>
      {% if mode == 'create' %}
      
        {% for i in 1..5 %}
          <label>
            Item {{ i }}
            <input type="text" name="equipment[]"><br>
          </label>
        {% endfor %}
     
      {% else %}
 
        {% for i in 1..5 %}
          <label>
            Item {{ i }}
            <input type="text" name="equipment[]" value="{{ character.equipment[i] }}"><br>
          </label>
        {% endfor %}

      {% endif %}
    </fieldset>
  
    {% if mode == 'create' %}
      <input type="submit" value="Submit" />
    {% else %}
      <input type="hidden" name="_METHOD" value="PUT">
      <input type="submit" value="Edit"><p>
    {% endif %}
  
  </form>

</body>
</html>
