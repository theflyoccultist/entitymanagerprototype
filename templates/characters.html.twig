<!DOCTYPE html>
<html>
<head>
  <title>Characters</title>
</head>
<body>
  <a href="/search">Search for characters</a>

{% if characters|length > 1 %}

  {% for character in characters %}
    <h1>Name: {{ character.name }}</h1>
    <a href="/characters/{{ id[loop.index - 1] }}">Access</a>

    <h4>Class: {{ character.class }}</h4>

    <ul>
      Stats:
        <li> Strength: {{ character.stats.strength }} </li>
        <li> Intelligence: {{ character.stats.intelligence }} </li>
        <li> Agility: {{ character.stats.agility }} </li>
    </ul>

    <ol>
      Equipment:
      {% for item in character.equipment %}
        {% if item is not empty %}
          <li> {{ item }} </li>
        {% endif %}
      {% endfor %}
    </ol>
  {% endfor %}

{% elseif characters|length == 1 %}

  <h1>Name: {{ characters.name }}</h1>
  <a href="/characters">Back to Characters List</a>

  <h4>Class: {{ characters.class }}</h4>

  <ul>
    Stats:
      <li> Strength: {{ characters.stats.strength }} </li>
      <li> Intelligence: {{ characters.stats.intelligence }} </li>
      <li> Agility: {{ characters.stats.agility }} </li>
  </ul>

  <ol>
    Equipment:
    {% for item in characters.equipment %}
      {% if item is not empty %}
        <li> {{ item }} </li>
      {% endif %}
    {% endfor %}
  </ol>
   
  <a href="/form/{{ id }}">Edit</a>
  
  <form action="" method="post">
    <input type="hidden" name="_METHOD" value="DELETE">
    <input type="submit" value="Delete"><p>
  </form>


{% else %}
  <h1> This character list is empty!</h1>
{% endif %}

<a href="/form">Create New Entry</a>

</body>
</html>
